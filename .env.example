# Root Environment Configuration Template
# Copy to .env or pass into docker-compose / orchestrator

PORT=5000
NODE_ENV=development

# Database configuration
DATABASE_URL=mysql://root:password123@localhost:3306/loan_ai_db

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-loan-ai-2026-production-change-me

# ML Microservice URL
ML_SERVICE_URL=http://localhost:8000

# Credit Bureau Integration (mock or verified)
CREDIT_PROVIDER_MODE=mock
CREDIT_PROVIDER_URL=https://api.creditbureau.example.com
CREDIT_PROVIDER_API_KEY=mock-bureau-api-key-demo

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
