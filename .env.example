# ==============================================================================
# Explainable AI-Based Digital Personal Loan Processing System
# Unified Environment Configuration Template (.env)
# ==============================================================================

# --- Application Runtime ---
APP_ENV=development
PORT=5000
HOST=0.0.0.0

# --- Persistence Tier ---
# Local Zero-Config (SQLite):
DATABASE_URL=sqlite:///./loan_eligibility.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://loan_user:SecurePassword123@localhost:5432/loan_eligibility_prod

# --- Security & JWT Tokens ---
# Generate a high-entropy secret for production: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
JWT_SECRET=super-secret-jwt-key-loan-ai-2026-production-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- 1. DigiLocker (API Setu) Integration ---
# Modes: "demo" (synthetic documents with DEMO labels) or "real" (API Setu OAuth 2.0 gateway)
DIGILOCKER_MODE=demo
DIGILOCKER_CLIENT_ID=DEMO_DIGILOCKER_ID
DIGILOCKER_CLIENT_SECRET=DEMO_DIGILOCKER_SECRET
DIGILOCKER_REDIRECT_URI=http://localhost:3000/digilocker/callback
DIGILOCKER_BASE_URL=https://api.apisetu.gov.in

# --- 2. Camera Face Authentication & Liveness ---
# Modes: "demo" (local luminance, face centering & heuristic checks) or "real" (enterprise biometric gateway)
FACE_VERIFICATION_MODE=demo
FACE_PROVIDER_API_KEY=DEMO_FACE_KEY
FACE_PROVIDER_ENDPOINT=https://api.faceverification.example.com/v1

# --- 3. Credit Assessment (TransUnion CIBIL) ---
# Modes: "demo" (calibrated synthetic bureau reports) or "real" (authorized bureau inquiry)
CREDIT_PROVIDER_MODE=demo
CIBIL_CLIENT_ID=DEMO_CIBIL_CLIENT
CIBIL_CLIENT_SECRET=DEMO_CIBIL_SECRET
CIBIL_ENDPOINT=https://api.creditbureau.example.com/v1

# --- 4. Bank Account Verification (Penny-Drop) ---
# Modes: "demo" (name similarity matching & account masking) or "real" (NPCI IMPS penny-drop gateway)
BANK_PROVIDER_MODE=demo
BANK_PROVIDER_CLIENT_ID=DEMO_BANK_CLIENT
BANK_PROVIDER_CLIENT_SECRET=DEMO_BANK_SECRET
BANK_PROVIDER_ENDPOINT=https://api.bankverification.example.com/v1

# --- 5. Loan Origination & Disbursement ---
# Modes: "demo" (simulated transaction ledger with non-real money banner) or "real" (lender origination system)
DISBURSEMENT_MODE=demo
DISBURSEMENT_API_KEY=DEMO_DISBURSEMENT_KEY
DISBURSEMENT_ENDPOINT=https://api.lenderorigination.example.com/v1
